ath{E_{i,c}=TE_{i,lab}=\\left[\\begin{matrix}0 & \\frac{\\sqrt{3}}{3} & - \\frac{\\sqrt{6}}{3}\\\\\\frac{\\sqrt{2}}{2} & - \\frac{\\sqrt{3}}{3} & - \\frac{\\sqrt{6}}{6}\\\\- \\frac{\\sqrt{2}}{2} & - \\frac{\\sqrt{3}}{3} & - \\frac{\\sqrt{6}}{6}\\end{matrix}\\right]\\,\\left[\\begin{matrix}\\frac{\\sqrt{2}}{2}\\\\\\frac{\\sqrt{2} i}{2}\\\\0\\end{matrix}\\right]=\\left[\\begin{matrix}\\frac{\\sqrt{6} i}{6}\\\\\\frac{3 - \\sqrt{6} i}{6}\\\\- \\frac{3 + \\sqrt{6} i}{6}\\end{matrix}\\right]}\\]\n\n\\[\\fitmath{\\mathcal P_c=R_cE_{i,c}=\\left[\\begin{matrix}0 & 0 & 0\\\\0 & 0 & 0\\\\0 & 0 & c\\end{matrix}\\right]\\,\\left[\\begin{matrix}\\frac{\\sqrt{6} i}{6}\\\\\\frac{3 - \\sqrt{6} i}{6}\\\\- \\frac{3 + \\sqrt{6} i}{6}\\end{matrix}\\right]=\\left[\\begin{matrix}0\\\\0\\\\- \\frac{c \\left(3 + \\sqrt{6} i\\right)}{6}\\end{matrix}\\right]}\\]\n\n\\[\\fitmath{\\mathcal P_{lab}=T^T\\mathcal P_c=\\left[\\begin{matrix}0 & \\frac{\\sqrt{2}}{2} & - \\frac{\\sqrt{2}}{2}\\\\\\frac{\\sqrt{3}}{3} & - \\frac{\\sqrt{3}}{3} & - \\frac{\\sqrt{3}}{3}\\\\- \\frac{\\sqrt{6}}{3} & - \\frac{\\sqrt{6}}{6} & - \\frac{\\sqrt{6}}{6}\\end{matrix}\\right]\\,\\left[\\begin{matrix}0\\\\0\\\\- \\frac{c \\left(3 + \\sqrt{6} i\\right)}{6}\\end{matrix}\\right]=\\left[\\begin{matrix}\\frac{c \\left(3 \\sqrt{2} + 2 \\sqrt{3} i\\right)}{12}\\\\\\frac{c \\left(\\sqrt{3} + \\sqrt{2} i\\right)}{6}\\\\\\frac{c \\left(\\sqrt{6} + 2 i\\right)}{12}\\end{matrix}\\right]}\\]\n\n\\[\\fitmath{E_{sc}=P\\mathcal P_{lab}=\\left[\\begin{matrix}1 & 0 & 0\\\\0 & 1 & 0\\end{matrix}\\right]\\,\\left[\\begin{matrix}\\frac{c \\left(3 \\sqrt{2} + 2 \\sqrt{3} i\\right)}{12}\\\\\\frac{c \\left(\\sqrt{3} + \\sqrt{2} i\\right)}{6}\\\\\\frac{c \\left(\\sqrt{6} + 2 i\\right)}{12}\\end{matrix}\\right]=\\left[\\begin{matrix}\\frac{c \\left(3 \\sqrt{2} + 2 \\sqrt{3} i\\right)}{12}\\\\\\frac{c \\left(\\sqrt{3} + \\sqrt{2} i\\right)}{6}\\end{matrix}\\right]}\\]\n\n\\[\\fitmath{E_{sc}=R_\\perp E_i=\\left[\\begin{matrix}\\frac{c}{2} & \\fra