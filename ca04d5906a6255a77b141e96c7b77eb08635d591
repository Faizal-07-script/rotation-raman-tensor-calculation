    "    [\n",
    "        [ref_a, ref_A * sp.exp(sp.I * ref_delta)],\n",
    "        [-ref_A * sp.exp(sp.I * ref_delta), ref_a * sp.exp(sp.I * ref_phi)],\n",
    "    ]\n",
    ")\n",
    "QWP_MODE = \"Quarter-wave-plate source model\"\n",
