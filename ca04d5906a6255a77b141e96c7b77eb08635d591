    "            known=True,\n",
    "            compatible=bool(abs(z[index]) > 1 - 1e-10 and parameters[\"N\"] == 2),\n",
    "            note=\"Check the unique C2 axis in the stated library convention.\",\n",
    "        )\n",
    "    elif run[\"config\"][\"point_group\"] in [\n",
    "        \"D3h\",\n",
