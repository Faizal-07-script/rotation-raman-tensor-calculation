    "\n",
    "\n",
    "\"\"\"Input transactions keep the crystal, geometry and optical protocol explicit.\"\"\"\n",
    "\n",
    "\n",
    "def clear_result():\n",
    "    for _, figure in state[\"figures\"]:\n",
    "        plt.close(figure)\n",
    "    state.update(run=None, figures=[], derivation=None, report=\"\", archive=None)\n",
