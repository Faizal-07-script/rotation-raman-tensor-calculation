    "            + ic * np.cos(2 * t)\n",
    "            + iss * np.sin(2 * t)\n",
    "            + i4c * np.cos(4 * t)\n",
    "            + i4s * np.sin(4 * t)\n",
    "            for t in stationary\n",
    "        ]\n",
    "    )\n",
    "    maximum, minimum = float(values.max()), float(values.min())\n",
    "    tolerance = 128 * np.finfo(float).eps * max(i0, maximum, np.finfo(float).tiny)\n",
