    "            raise ValueError(\"The evaluated scattering amplitudes are not finite.\")\n",
    "        pairs.append(pair)\n",
    "    if not pairs:\n",
    "        raise ValueError(\"At least one scattering channel is required.\")\n",
    "    return np.asarray(pairs)\n",
