    "    invalidate()\n",
    "\n",
    "\n",
    "def on_surface(_=None):\n",
    "    if ui[\"busy\"]:\n",
    "        return\n",
    "    if surface_pick.value in surface_options:\n",
    "        indices, direction = surface_options[surface_pick.value]\n",
