    "                + (dv * np.sin(2 * angles)) ** 2\n",
    "                + np.sin(2 * angles)\n",
    "                * (\n",
    "                    av * bv * np.cos(phase_b) * np.sin(2 * angles) / 2\n",
    "                    - 2 * av * dv * np.cos(phase_d) * cs**2\n",
    "                    - 2 * bv * dv * np.cos(phase_d - phase_b) * ss**2\n",
    "                )\n",
    "            )\n",
