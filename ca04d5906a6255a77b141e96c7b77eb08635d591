    "        display(Markdown(\"**\" + group_pick.value + \"** \u2014 \" + axes))\n",
    "        for name, item in definitions.items():\n",
    "            display(\n",
    "                Markdown(\n",
    "                    f\"**{name}** ({item['irrep']}), {len(item['partners']) or 1} tensor(s)/partner(s)\"\n",
