    "        \"D3\",\n",
    "        \"C3v\",\n",
    "        \"C6v\",\n",
    "        \"D4\",\n",
    "        \"D4h\",\n",
    "        \"C4v\",\n",
    "    ]:\n",
    "        z = numeric(run[\"geometry\"][\"T\"][:, 2]).real.reshape(3)\n",
    "        order = (\n",
    "            3\n",
    "            if run[\"config\"][\"point_group\"] in [\"D3h\", \"D3d\", \"D3\", \"C3v\"]\n",
    "            else 4 if run[\"config\"][\"point_group\"] in [\"D4\", \"D4h\", \"C4v\"] else 6\n",
    "        )\n",
